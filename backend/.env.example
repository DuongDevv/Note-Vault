# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 18.

PORT=5000
NODE_ENV=development

# Database Config
DB_URL="postgres://alex:pwd@ep-cool-breeze-123456.us-east-2.aws.neon.tech/neondb?sslmode=verify-full" # optional if use cloud database
DB_HOST="localhost"
DB_PORT=5432
DB_USERNAME="postgres"
DB_PASSWORD="postgres_password"
DB_DATABASE="note_vault_db"

# Redis Config
REDIS_URL="rediss://default:yourpassword@shared-redis-123.upstash.io:6379" # optional if use cloud redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Security Secrets
JWT_SECRET=super_secret_jwt_access_key_development_notevault
PRIVATE_NOTE_MASTER_KEY=default_32_bytes_key_for_aes_256_notevault
