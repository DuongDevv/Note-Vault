datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  username       String   @unique @db.VarChar(50)
  email          String   @unique @db.VarChar(100)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  displayName    String   @default("Người dùng") @map("display_name") @db.VarChar(100)
  privatePinHash String?  @map("private_pin_hash") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  topics Topic[]
  notes  Note[]

  @@map("users")
}

model Topic {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@unique([userId, name], name: "uq_user_topic_name")
  @@map("topics")
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  topicId   String?  @map("topic_id") @db.Uuid
  title     String   @db.VarChar(255)
  content   String?  @db.Text
  tags      String[] @default([])
  isLocked  Boolean  @default(false) @map("is_locked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId], map: "idx_notes_user_topic")
  @@index([userId, createdAt], map: "idx_notes_user_created")
  @@map("notes")
}
